{
  "name": "safariyyds",
  "version": "0.2.4-rc.1",
  "description": "Find Chromium apps on macOS",
  "type": "module",
  "bin": {
    "safariyyds": "dist/index.js"
  },
  "files": [
    "dist",
    "docs/report-sample.png"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check": "tsc --noEmit",
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "prepare": "bun run build",
    "prepublishOnly": "bun run check && bun run build",
    "release:check": "bun run prepublishOnly && npm pack --dry-run"
  },
  "keywords": [
    "macos",
    "chromium",
    "chrome",
    "electron",
    "browser",
    "cli",
    "report"
  ],
  "author": "ThaddeusJiang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThaddeusJiang/SafariYYDS-js.git"
  },
  "bugs": {
    "url": "https://github.com/ThaddeusJiang/SafariYYDS-js/issues"
  },
  "homepage": "https://github.com/ThaddeusJiang/SafariYYDS-js#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin"
  ],
  "packageManager": "bun@1.3.11",
  "dependencies": {
    "@resvg/resvg-js": "2.6.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "24.12.4",
    "typescript": "5.9.3"
  }
}
